# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/.verification/
/verification-output/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.log
*.jsonl
*.pem
*.key
*.p12
*.pfx
/certificates/
/desktop/certificates/

# Never publish copied Pi/Codex runtime state or locally imported companion data.
.pi/
.codex/
.pi-gui-data/
/local-pets/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.factory
